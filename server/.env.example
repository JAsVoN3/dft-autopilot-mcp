# =============================================================================
# DFT AutoPilot — 环境变量示例
# 复制为 .env 并填入你自己的值。切勿把真实 .env 提交到版本库。
#   cp .env.example .env
# =============================================================================

APP_ENV=production

# -----------------------------------------------------------------------------
# LLM（仅供需要 LLM 的工具使用；OpenAI 兼容格式，支持中转站）
# 注意：在 Claude Desktop / Claude Code 中通过 MCP 调用时，对话用的大模型由客户端提供，
#       这里的 LLM_* 仅用于服务器内部少数需要独立调用 LLM 的功能（可留空）。
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# -----------------------------------------------------------------------------
# 外部 API Key
# -----------------------------------------------------------------------------
# Materials Project（材料数据库）：https://next-gen.materialsproject.org/api
MP_API_KEY=
# 可选：MP API 代理 URL（部分网络环境绕过访问限制）
MP_PROXY_URL=
# 可选：Semantic Scholar（文献检索，可不填走匿名额度）
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# 本地 QE 执行（COMPUTE_PROVIDER=local 或本机后处理时使用）
# -----------------------------------------------------------------------------
QE_PSEUDO_DIR=
QE_WORK_DIR=
QE_NUM_CORES=16
QE_TIMEOUT_SECONDS=86400

# =============================================================================
# 算力后端（BYO-HPC）：scnet | slurm | local
# =============================================================================
COMPUTE_PROVIDER=local

# -----------------------------------------------------------------------------
# 后端 A：通用 Slurm 集群（over SSH）—— 推荐给有自己超算/课题组集群的用户
# 前提：本机已配置到登录节点的免密 SSH（公钥已加入 authorized_keys）
# -----------------------------------------------------------------------------
# SSH 目标：user@login.cluster.edu 或 ~/.ssh/config 中的别名
SLURM_HOST=
# 远程用户名（用于 squeue -u；留空则用远程 $USER）
SLURM_USER=
# 远程作业根目录，如 /scratch/yourname/dft-autopilot
SLURM_REMOTE_BASE_DIR=
# Slurm 分区/队列
SLURM_PARTITION=
# 可选 --account
SLURM_ACCOUNT=
# 加载引擎环境的 shell 命令（分号或换行分隔），如：module load quantum-espresso/7.4
SLURM_MODULES=
# 远程赝势目录（用于 QE 输入 pseudo_dir 重写；留空则不重写）
SLURM_PSEUDO_DIR=
# 远程 QE 可执行文件目录（留空则假定已在 PATH 中）
SLURM_QE_BIN_DIR=
SLURM_MAX_CORES_PER_NODE=64
SLURM_WALL_TIME=24:00:00
# 透传给 ssh/scp 的附加选项，如 "-p 2222 -i ~/.ssh/hpc_key"
SLURM_SSH_OPTS=

# -----------------------------------------------------------------------------
# 后端 B：国家超算互联网 SCNet —— 用你自己的 SCNet 账号填写（本仓库不含任何账号）
# 申请/文档：https://www.scnet.cn/
# -----------------------------------------------------------------------------
SCNET_USER=
SCNET_ACCESS_KEY=
SCNET_SECRET_KEY=
SCNET_CLUSTER_NAME=
SCNET_CLUSTER_ID=
SCNET_HPC_URL=
SCNET_EFILE_URL=
SCNET_HOME_PATH=
SCNET_QUEUE=
SCNET_SCHEDULER_ID=
SCNET_QE_PATH=
SCNET_QE_ENV_SCRIPT=
SCNET_PSEUDO_DIR=
SCNET_VASP_ENV_SCRIPT=
SCNET_POTCAR_DIR=
SCNET_GAUSSIAN_ENV_SCRIPT=
SCNET_SCRATCH_DIR=
SCNET_MAX_CORES=64
SCNET_MAX_CORES_PER_JOB=256
